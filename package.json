{
  "name": "codex-remote",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "bun --watch server/index.ts",
    "typecheck": "vue-tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "bun run typecheck && vite build",
    "start": "bun server/index.ts",
    "test": "bun test tests/unit tests/integration",
    "test:e2e": "bun ./node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@phosphor-icons/vue": "^2.2.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "mermaid": "^12.1.0",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.43",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.4.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "^14.2.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vue-tsc": "^3.3.11"
  }
}
