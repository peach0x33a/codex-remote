# Loopback is the safe default. Use HTTPS for installation on another device.
HOST=127.0.0.1
PORT=3000
# Required together when HOST is not loopback:
# APP_ACCESS_KEY=replace-with-a-long-random-password
# APP_ORIGIN=https://codex.example.com
# Optional exact endpoint hostname allowlist; comma separated; no wildcards.
# APP_ALLOWED_HOSTS=127.0.0.1,localhost,codex.internal.example
# Disable Unix sockets if this deployment should only reach TCP endpoints.
# ALLOW_UNIX_SOCKETS=false
